  mpg ~ b*wt + c_prime*hp
  hp ~~ hp;  wt ~~ wt;  mpg ~~ mpg
  hp ~ 1;  wt ~ 1;  mpg ~ 1
  ab := a * b
"
res2 <- fastsem_fit(syntax2, df2)
cat("Indirect hp->wt->mpg:", res2$estimates[res2$paramNames == "ab"],
    "+/-", res2$se[res2$paramNames == "ab"], "\n")
}
}
