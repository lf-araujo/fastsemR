                 y2 = 0.9*f + rnorm(n, sd=0.5),
                 y3 = 0.7*f + rnorm(n, sd=0.7))

syntax <- "
  f =~ 1*y1 + y2 + y3
  f ~~ f
  y1 ~~ y1;  y2 ~~ y2;  y3 ~~ y3
"
res <- fastsem_fit(syntax, df)
print_fastsem(res)

